  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "./scripts/android-device.sh",
    "android:metro": "adb reverse tcp:8081 tcp:8081 && expo start --dev-client",
    "android:logs": "adb logcat ReactNativeJS:V ReactNative:V '*:S'",
    "android:clean": "cd android && ./gradlew clean",
    "android:doctor": "npx expo-doctor",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint App",
    "typecheck": "tsc --noEmit"
  },
